{
  "name": "plants-game",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate:content",
    "build": "vue-tsc -b --force && vite build",
    "postbuild": "npm run verify:deploy",
    "preview": "vite preview",
    "pretest": "npm run validate:content",
    "test": "vitest run",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "validate:content": "tsx scripts/validate-content.ts",
    "verify:deploy": "tsx scripts/verify-deploy.ts",
    "verify:portrait": "tsx scripts/verify-portrait-layout.ts",
    "balance-sim": "tsx scripts/balance-sim.ts",
    "generate:voice": "tsx scripts/generate-voice.ts",
    "word-image-metrics": "tsx scripts/word-image-metrics.ts",
    "word-image-throughput": "tsx scripts/word-image-throughput.ts"
  },
  "dependencies": {
    "vue": "~3.5.43",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
