{
  "name": "pvz-pixel",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:cross-device": "playwright test e2e/cross-device/",
    "test:cross-device:medium": "playwright test e2e/cross-device/ --grep @medium",
    "test:cross-device:slow": "playwright test e2e/cross-device/ --grep @slow",
    "test:cross-device:update-snapshots": "playwright test e2e/cross-device/ --grep @slow --update-snapshots"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "phaser": "^3.60.0",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.2"
  }
}
